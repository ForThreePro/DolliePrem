let handler = async (m, { conn, usedPrefix, command, isAdmin }) => {
    if (!isAdmin) return m.reply(`╭─🎀─❒ *『 𝗗𝗢𝗟𝗟𝗜𝗘 𝗕𝗢𝗧 』* ❒─🎀─╮\n│ 😡 *¡Solo admins pueden!*\n╰─────────────────────────🎀`)

    let chat = global.db.data.chats[m.chat] || {}
    if (!chat) global.db.data.chats[m.chat] = chat

    if (command === 'offbot') {
        chat.isBanned = true
        await global.db.write()
        return m.reply(`╭─🎀─❒ *『 𝗗𝗢𝗟𝗟𝗜𝗘 𝗕𝗢𝗧 』* ❒─🎀─╮
│ 😴 *Dollie se va a dormir* 😴
│
│ *No responderé en este grupo*
│ *Despiértame con:* *${usedPrefix}onbot*
╰─────────────────────────🎀`)
    }

    if (command === 'onbot') {
        chat.isBanned = false
        await global.db.write()
        return m.reply(`╭─🎀─❒ *『 𝗗𝗢𝗟𝗟𝗜𝗘 𝗕𝗢𝗧 』* ❒─🎀─╮
│ ✨ *¡Dollie despertó!* ✨
│
│ *Ya puedo responder otra vez* 💫
│ *Gracias por activarme* 🎀
╰─────────────────────────🎀`)
    }
}
handler.help = ['offbot', 'onbot']
handler.tags = ['admin']
handler.command = /^(offbot|onbot)$/i
handler.admin = true
handler.group = true
export default handler